# Server only. For Supabase Cloud, replace PROJECT_REF and PASSWORD.
# Prefer the direct connection or session pooler URL for long-running API/worker processes.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_AUDIENCE=authenticated
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=replace-with-local-secret-key
RETURN_TRACKING_ENCRYPTION_KEY=replace-with-random-secret-at-least-32-characters
RETURN_TRACKING_HMAC_KEY=replace-with-a-different-random-secret-at-least-32-characters
SELLER_PII_ENCRYPTION_KEY=replace-with-random-secret-at-least-32-characters
VNPT_EKYC_BASE_URL=https://api.idg.vnpt.vn
VNPT_EKYC_ACCESS_TOKEN=replace-with-vnpt-access-token
VNPT_EKYC_TOKEN_ID=replace-with-vnpt-token-id
VNPT_EKYC_TOKEN_KEY=replace-with-vnpt-token-key
VNPT_EKYC_MAC_ADDRESS=replace-with-registered-mac-address
# Confirm these module paths against the VNPT contract/version provisioned to your tenant.
VNPT_EKYC_OCR_PATH=/ai/v1/ocr/id
VNPT_EKYC_DOCUMENT_VALIDATION_PATH=/ai/v1/card/liveness
VNPT_EKYC_FACE_COMPARE_PATH=/ai/v1/face/compare
VNPT_EKYC_LIVENESS_PATH=/ai/v1/face/liveness
VNPT_EKYC_FACE_THRESHOLD=0.9
VNPT_EKYC_LIVENESS_THRESHOLD=0.9
# Internal adapters must return { "verified": true, "registeredName": "..." }.
TAX_VERIFICATION_URL=
BANK_VERIFICATION_URL=
BUSINESS_VERIFICATION_TOKEN=
API_PORT=3001
WEB_ORIGIN=http://localhost:3000

# Next.js server and browser-safe values only.
API_URL=http://127.0.0.1:3001
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
NEXT_PUBLIC_SUPPORT_HOTLINE=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Supabase Cloud shape (copy values from Project Settings > API/Database):
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# SUPABASE_ISSUER=https://PROJECT_REF.supabase.co/auth/v1
# SUPABASE_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
COMMERCE_MODE=SANDBOX
PAYMENT_MODE=DISABLED
FULFILLMENT_MODE=FAKE
EVIDENCE_MODE=FAKE_METADATA
NOTIFICATION_MODE=IN_APP_OR_LOG

# Marketplace credentials belong to the REBOXE application, never entered by sellers.
# Configure this exact callback in both partner consoles.
MARKETPLACE_CALLBACK_URL=http://localhost:3000/seller/connections
MARKETPLACE_TOKEN_ENCRYPTION_KEY=
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# Confirm refresh lifetime against the app's approved contract.
SHOPEE_REFRESH_TOKEN_TTL_SECONDS=2592000
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SERVICE_ID=

# Private AI service. Omit URL/token to keep human review only.
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TOKEN=
AI_MODEL_ID=Qwen/Qwen3-VL-4B-Instruct
# Immutable model commit, obtained after reviewing the model card/license.
AI_MODEL_REVISION=ebb281ec70b05090aa6165b016eac8ec08e71b17
# Enable only after provisioning a private, versioned bucket with Object Lock and approved region.
EVIDENCE_S3_BUCKET=
EVIDENCE_S3_REGION=ap-southeast-1
PAYOS_PROMOTION_PAYMENTS_ENABLED=false
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_EXPECTED_ACCOUNT_NUMBER=
PAYOS_EXPECTED_BANK_BIN=
GHN_ENVIRONMENT=STAGING
GHN_TOKEN=
# One registered GHN pickup shop per REBOXE seller; never quote every seller from one warehouse.
GHN_SHOP_MAPPING={}
# Register /v1/webhooks/payos/promotions on this REBOXE service-payment channel.
# It must never be used to collect marketplace goods payments intended for sellers.
# AWS credentials use the standard server-side AWS credential chain / workload identity.
