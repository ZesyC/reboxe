{
  "name": "@reboxe/backend",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "seed": "node dist/platform/database/seed.js",
    "migrate": "node --env-file-if-exists=../../.env dist/platform/database/migrate.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@payos/node": "^2.0.5",
    "@reboxe/shared": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "read-excel-file": "9.3.4",
    "ulid": "3.0.2"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
