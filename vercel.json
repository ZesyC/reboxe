{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "corepack pnpm install --frozen-lockfile",
      "buildCommand": "corepack pnpm --filter @reboxe/web... build",
      "bindings": [
        { "type": "service", "service": "api", "format": "url", "env": "API_URL" }
      ]
    },
    "api": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "daemons": {
    "worker": {
      "root": ".",
      "entrypoint": "Dockerfile.vercel",
      "command": ["node", "/app/apps/worker/dist/main.js"],
      "instances": { "sin1": 1 },
      "resources": { "requests": { "memory": "1Gi" } }
    }
  },
  "rewrites": [
    { "source": "/v1/:path*", "destination": { "service": "api" } },
    { "source": "/health/:path*", "destination": { "service": "api" } },
    { "source": "/", "destination": { "service": "web" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
